    "canonical_acceptance": "A separate explicit owner/canon decision is required to change canon_state.",
    "required_receipt_fields": [
      "review_id",
      "target_id",
      "source_commit",
      "asset_sha256",
      "lens",
      "reviewer_id",
      "reviewed_on",
      "decision",
      "findings",
      "evidence_refs"
    ],
    "passing_rule": "No open blocking findings across visual_identity, story_and_canon, gameplay and runtime_boundary. Pending review is never a pass.",
    "mutation_route": "Submit a review receipt by GitHub pull request against this batch. Do not edit a different agent’s receipt or record a review on their behalf."
  },
  "lenses": [
    {
      "id": "visual_identity",
      "responsibility": "Character/visual reviewer",
      "checks": [
        "distinct silhouette at thumbnail size",
        "two images preserve identity locks",
        "allies read as welcoming and opponents carry threat",
        "visible action, emotion and earned result",
        "no unreadable baked-in explanatory text",
        "camera, anatomy, scale and material integrity"
      ],
      "evidence": [
        "asset hashes",
        "annotated image observations"
      ]
    },
    {
      "id": "story_and_canon",
      "responsibility": "Canon reviewer",
      "checks": [
        "proposal state and visibility retained",
        "no collision with inspected source lore",
        "Field behavior has cost and explicit limit",
        "relationships are labelled proposals",
        "no new cosmological office accepted by implication",
        "source and rights locators present"
      ],
      "evidence": [
        "pinned source locators",
        "named contradictions or explicit none within scope"
      ]
    },
    {
      "id": "gameplay",
      "responsibility": "Game designer / play reviewer",
      "checks": [
        "one useful teammate action per role",
        "failure is legible and recoverable",
        "finite reserve visible",
        "cooperative acknowledgement can be learned",
        "companions remain characters rather than dashboards",
        "no simulation win represented as real work"
      ],
      "evidence": [
        "encounter fixture",
        "observed interaction receipt when implemented"
      ]
    },
    {
      "id": "runtime_boundary",
      "responsibility": "Agent systems reviewer",
      "checks": [
        "fiction never authorizes tools",
        "fixed budget, retry and stop contracts",
        "independent artifact acceptance",
        "provenance and source revision preserved",
        "duplicate work and missing acknowledgements are tested",
        "no live-agent execution claimed without observed receipts"
      ],
      "evidence": [
        "bounded task fixture",
        "runtime test receipts",
        "clear implemented/planned state"
      ]
    }
  ],
